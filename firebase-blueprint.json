{
  "entities": {
    "Test": {
      "title": "Test",
      "description": "A generated mock exam",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "createdAt": { "type": "number" },
        "status": { "type": "string", "enum": ["setup", "in-progress", "completed"] },
        "config": {
          "type": "object",
          "properties": {
            "mcqStatic": { "type": "number" },
            "mcqDynamic": { "type": "number" },
            "descStatic": { "type": "number" },
            "descDynamic": { "type": "number" }
          }
        },
        "sourceNoteFileRefs": { "type": "array", "items": { "type": "string" } },
        "extractedNotesText": { "type": "string" },
        "durationSeconds": { "type": "number" },
        "startedAt": { "type": "number" },
        "submittedAt": { "type": "number" },
        "answers": {
          "type": "object",
          "description": "questionId to userAnswer mapping"
        },
        "totalScore": { "type": "number" },
        "sectionScores": { "type": "object" },
        "feedback": { "type": "object" },
        "evaluations": { "type": "object" },
        "overallFeedback": { "type": "object" },
        "isEvaluated": { "type": "boolean" },
        "evaluatedAt": { "type": "number" }
      },
      "required": ["userId", "createdAt"]
    },
    "Question": {
      "title": "Question",
      "description": "A single question in a test",
      "type": "object",
      "properties": {
        "testId": { "type": "string" },
        "type": { "type": "string", "enum": ["MCQ", "Descriptive"] },
        "sourceTag": { "type": "string", "enum": ["Static", "Dynamic"] },
        "text": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" } },
        "correctAnswer": { "type": "string" },
        "modelAnswer": { "type": "string" },
        "markingScheme": { "type": "object" },
        "wordLimit": { "type": "number" },
        "maxMarks": { "type": "number" },
        "userAnswer": { "type": "string" },
        "score": { "type": "number" },
        "evaluation": { "type": "object" }
      },
      "required": ["testId", "type", "sourceTag", "text"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Cadre officer profile and preparation parameters",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "email": { "type": "string" },
        "stream": { "type": "string", "enum": ["General", "DEPR", "DSIM"] },
        "category": { "type": "string" },
        "attemptCount": { "type": "string" },
        "dailyStudyHours": { "type": "number" },
        "educationBackground": { "type": "string" },
        "bio": { "type": "string" },
        "phone": { "type": "string" },
        "targetExamYear": { "type": "string" },
        "targetExamDate": { "type": "string" },
        "targetScoreGoal": { "type": "number" },
        "updatedAt": { "type": "number" }
      }
    },
    "FlashcardDeck": {
      "title": "FlashcardDeck",
      "description": "A subject-scoped active recall flashcard deck generated from uploaded PDF or image notes",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "subjectId": { "type": "string" },
        "subjectSlug": { "type": "string" },
        "subjectName": { "type": "string" },
        "title": { "type": "string" },
        "topic": { "type": "string" },
        "sourceFileNames": { "type": "array" },
        "sourceFileTypes": { "type": "array" },
        "cardCount": { "type": "number" },
        "cards": { "type": "array" },
        "createdAt": { "type": "number" },
        "lastStudiedAt": { "type": "number" },
        "bestEfficiency": { "type": "number" },
        "totalSessions": { "type": "number" }
      },
      "required": ["userId", "subjectId", "subjectSlug", "subjectName", "title", "topic", "cardCount", "cards", "createdAt"]
    },
    "FlashcardSession": {
      "title": "FlashcardSession",
      "description": "A completed flashcard study session storing recall ratings and learning efficiency analytics",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "deckId": { "type": "string" },
        "deckTitle": { "type": "string" },
        "subjectId": { "type": "string" },
        "subjectSlug": { "type": "string" },
        "subjectName": { "type": "string" },
        "topic": { "type": "string" },
        "mode": { "type": "string", "enum": ["full", "weak-drill"] },
        "startedAt": { "type": "number" },
        "completedAt": { "type": "number" },
        "durationSeconds": { "type": "number" },
        "totalCards": { "type": "number" },
        "masteredCount": { "type": "number" },
        "goodCount": { "type": "number" },
        "hardCount": { "type": "number" },
        "againCount": { "type": "number" },
        "efficiencyScore": { "type": "number" },
        "retentionRatePct": { "type": "number" },
        "avgSecondsPerCard": { "type": "number" },
        "weakCardIds": { "type": "array" },
        "cardResults": { "type": "array" }
      },
      "required": ["userId", "deckId", "deckTitle", "subjectId", "subjectSlug", "subjectName", "mode", "startedAt", "completedAt", "durationSeconds", "totalCards", "efficiencyScore", "cardResults"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile and target settings"
    },
    "/tests/{testId}": {
      "schema": { "$ref": "#/entities/Test" },
      "description": "Test records"
    },
    "/tests/{testId}/questions/{questionId}": {
      "schema": { "$ref": "#/entities/Question" },
      "description": "Questions for a test"
    },
    "/flashcardDecks/{deckId}": {
      "schema": { "$ref": "#/entities/FlashcardDeck" },
      "description": "User-owned flashcard decks segregated by RBI Grade B subject"
    },
    "/flashcardSessions/{sessionId}": {
      "schema": { "$ref": "#/entities/FlashcardSession" },
      "description": "Completed flashcard study session results and efficiency analytics"
    }
  }
}

